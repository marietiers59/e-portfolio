#!/bin/sh
# Refuse un message de commit qui ne cite aucun ticket (#N).
# Activation (une seule fois par clone) : git config core.hooksPath .githooks
msg_file="$1"
first_line=$(head -n 1 "$msg_file")
case "$first_line" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac
if grep -v '^#' "$msg_file" | grep -Eq '#[0-9]+'; then
  exit 0
fi
echo "commit refusé : le message doit citer au moins un ticket, par exemple « (#145) » ou « Refs #69 »." >&2
echo "liste des tickets : https://github.com/marietiers59/e-portfolio/issues" >&2
exit 1
